NODE_ENV=development
PORT=3000

# Never commit a real .env.
# @template:only:start
# `npm run init` creates .env from this file with a generated API_KEY.
# @template:only:end
# Required, at least 16 characters. Use a long random value: it is the only credential of the API.
API_KEY=change-me-with-a-long-random-value

# Serve Swagger UI at /docs on the local server (ignored when NODE_ENV=production)
DOCS_ENABLED=true

# Optional. Connections the database pool of one process may open (1 to 20, default 2). In Lambda every
# container has its own pool: see docs/SERVERLESS.md before raising it.
# DB_POOL_MAX=2

# Host port of the database started by `docker compose up -d`. If 5432 is taken on your machine,
# uncomment it with another port and use the same port in the two URLs below.
# DB_PORT=5432

# Runtime connection (a pooled endpoint is fine here)
DATABASE_URL=postgresql://user:password@localhost:5432/my_service_api

# Used only by the Prisma CLI (prisma migrate dev)
SHADOW_DATABASE_URL=postgresql://user:password@localhost:5432/my_service_api_shadow

# Used only by `npm run test:integration`. The name must end with _test: the tests delete every row.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/my_service_api_test
